{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/entity.json",
  "metamodel_version": "1.0.0",
  "title": "Entity",
  "description": "Abstract root type for all DEA metamodel entities.",
  "type": "object",
  "abstract": true,
  "required": ["id", "name", "type", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$", "description": "URN-style identifier, e.g. dea:tenet-api-first"},
    "type": {"type": "string", "const": "Entity", "description": "Metamodel entity type discriminator."},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "lifecycle_status": {"type": "string", "enum": ["proposed", "planned", "active", "deprecated", "retired"]},
    "external_references": {"type": "array", "items": {"type": "object", "required": ["system", "identifier"], "properties": {"system": {"type": "string"}, "identifier": {"type": "string"}}}},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "uniqueItems": true},
    "relationships": {"type": "array", "items": {"$ref": "../relationships/relationship-instance.json"}},
    "metadata": {"type": "object", "properties": {"created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string"}, "status": {"type": "string", "enum": ["draft", "candidate", "approved", "deprecated"]}}}
  }
}
