{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/relationships/relationship-instance.json",
  "metamodel_version": "1.0.0",
  "title": "RelationshipInstance",
  "description": "An instantiated typed relationship between two entities (CR-002: typed, directed, versioned, provenance-aware).",
  "type": "object",
  "required": ["source_id", "target_id", "relationship_type"],
  "properties": {
    "id": {"type": "string", "description": "Instance identifier."},
    "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$", "description": "Source entity ID."},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$", "description": "Target entity ID."},
    "relationship_type": {"type": "string", "enum": ["accesses", "accountable-for", "addressed-by", "affects", "aggregates", "analyses-metric", "applies-metric", "applies-period", "applies-subject", "approves", "assessed-by", "assesses", "attains", "authorized-by", "authorizes", "benchmarked-against", "captures", "caused-by", "composes", "conducted-under", "constrained-by", "constrains", "consults", "consumes", "contains", "contributes-to", "controls", "coordinates", "corrects", "correlates", "curates", "defines", "delegates", "depends-on", "derived-from", "derives-from", "enables", "enforces", "escalates-to", "establishes", "evaluated-by", "evaluates", "evidenced-by", "exchanges", "executes", "exposes", "flows-to", "from-state", "governs", "grants", "has-designation", "has-oversight", "has-provenance", "has-skill", "has-target", "implements", "in-state", "informed-by", "informs", "informs-decision", "instantiates", "interprets", "introduces", "invokes", "makes", "mandates", "maps-onto", "maps-to", "may-become", "measured-by", "measures-subject", "migrates-to", "mitigates", "modifies", "motivates", "operationalizes", "orchestrates", "originates-from", "owns", "performed-by", "performs", "permits", "precedes", "produces", "prohibits", "provides", "publishes", "quantifies", "realizes", "records", "references", "refers-to", "removes", "replaces", "represents", "requires", "requires-approval", "responsible-for", "results-in", "scoped-by", "seeks", "serves", "specializes", "specifies", "specifies-target", "structures", "subscribes-to", "supersedes", "supports", "targets", "tests-hypothesis", "threatens", "to-state", "traces-to", "trained-on", "transitions-to", "triggers", "uses", "valid-during", "version-of"], "description": "Canonical relationship type (registry id without dea: prefix)."},
    "direction": {"type": "string", "enum": ["source-to-target"], "default": "source-to-target"},
    "mapping": {"type": "object", "properties": {"kind": {"type": "string", "enum": ["equivalent", "broader", "narrower", "related", "traceability", "external-crosswalk"]}}},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["proposed", "planned", "active", "deprecated", "retired"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "asserted_by": {"type": "string"},
    "rationale": {"type": "string", "maxLength": 1000},
    "evidence": {"type": "string", "maxLength": 1000},
    "provenance": {"type": "object", "properties": {"type": {"type": "string", "enum": ["architecture-review", "discovery", "assessment", "inference", "migration", "manual"]}, "reference": {"type": "string"}, "asserted_by": {"type": "string"}, "asserted_at": {"type": "string", "format": "date"}, "system": {"type": "string"}, "framework": {"type": "string"}, "agent_id": {"type": "string"}, "verification_status": {"type": "string", "enum": ["unverified", "verified", "rejected"]}}},
    "description": {"type": "string", "maxLength": 500},
    "weight": {"type": "number", "minimum": 0, "maximum": 1, "deprecated": true},
    "bidirectional": {"type": "boolean", "deprecated": true},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
